# Groq (real LLM) - keep this file private, NEVER commit or share it
GROQ_API_KEY=

# Which backend should the demo use? "groq" = real hosted LLM, "dryrun" = deterministic local mock
# Auto-detect: empty key or "dryrun" here -> local mock; a real key -> Groq
# Set a concrete model name from your Groq console, e.g. openai/gpt-oss-120b
# (the older llama-3.3-70b-versatile is no longer served on Groq)
GROQ_MODEL=openai/gpt-oss-120b